            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "User-Agent",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of supported crypto currencies and their supported chains."
        }
      ]
    }
  ],
  "bundled": true
